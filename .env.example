# Copy this file to .env (which is never committed) and fill in your own key.
DEEPSEEK_API_KEY=sk-your-key-here
# Optional: research model name and API address used by src/llm.py
# The serving API pins its model to results/llm/selection.json.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
