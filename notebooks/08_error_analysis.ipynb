    "    return cm / cm.sum(axis=1, keepdims=True)\n",
    "\n",
    "\n",
    "cm_bert, cm_lr = row_normalised(y_test, preds[\"bert\"]), row_normalised(y_test, preds[\"tfidf_lr\"])\n",
    "fig, axes = plt.subplots(1, 3, figsize=(17, 5.2))\n",
    "for ax, cm, title in [(axes[0], cm_lr, \"TF-IDF + LR (baseline)\"), (axes[1], cm_bert, \"BERT fine-tuned (best)\")]:\n",
    "    sns.heatmap(cm, annot=True, fmt=\".2f\", cmap=\"Blues\", vmin=0, vmax=1, cbar=False, linewidths=1.5,\n",
    "                linecolor=\"white\", xticklabels=LABELS, yticklabels=LABELS, ax=ax)\n",
    "    ax.set_title(title)\n",
    "    ax.set_xlabel(\"Predicted label\")\n",
    "    ax.set_ylabel(\"True label\")\n",
    "diff = cm_bert - cm_lr\n",
    "limit = np.abs(diff).max()\n",
    "annot = np.vectorize(lambda v: \"0.00\" if abs(v) < 0.005 else f\"{v:+.2f}\")(diff)\n",
    "sns.heatmap(diff, annot=annot, fmt=\"\", cmap=\"RdBu\", norm=TwoSlopeNorm(0, -limit, limit), linewidths=1.5,\n",
    "            linecolor=\"white\", xticklabels=LABELS, yticklabels=LABELS, ax=axes[2],\n",
