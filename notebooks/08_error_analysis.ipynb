    "per_class = pd.DataFrame({m: {c: records[m][\"per_class\"][c][\"f1\"] for c in LABELS} for m in LADDER}).T\n",
    "support = {c: records[\"bert\"][\"per_class\"][c][\"support\"] for c in LABELS}\n",
