    "sub_rows = []\n",
    "for m in LADDER + [\"llm_zeroshot\", \"llm\"]:\n",
    "    low, high = bootstrap_ci(y_sub, sub_preds[m])\n",
    "    name = DISPLAY.get(m, \"DeepSeek zero-shot\")\n",
    "    sub_rows.append({\"model id\": m, \"model\": name,\n",
    "                     \"step\": MODEL_INFO.get(m, MODEL_INFO[\"llm\"])[\"step\"],\n",
    "                     \"accuracy\": float(np.mean(sub_preds[m] == y_sub)), \"macro-F1\": macro_f1(y_sub, sub_preds[m]),\n",
    "                     \"ci_low\": low, \"ci_high\": high})\n",
    "ledger_sub = pd.DataFrame(sub_rows).set_index(\"model id\")\n",
    "ledger_sub[\"95% CI\"] = [f\"[{a:.3f}, {b:.3f}]\" for a, b in zip(ledger_sub.ci_low, ledger_sub.ci_high)]\n",
    "display(ledger_sub.drop(columns=[\"ci_low\", \"ci_high\"]).style.format({\"accuracy\": \"{:.3f}\", \"macro-F1\": \"{:.3f}\"}))\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(13, 4.6), gridspec_kw={\"width_ratios\": [1, 1]}, sharey=False)\n",
    "for ax, table, title, models in [\n",
    "    (axes[0], ledger.rename(columns={\"test macro-F1\": \"macro-F1\"}), \"Full test split (2,000 texts)\", LADDER),\n",
    "    (axes[1], ledger_sub, \"Test subset (300 texts), with the LLM\", LADDER + [\"llm_zeroshot\", \"llm\"]),\n",
    "]:\n",
    "    y = np.arange(len(models))[::-1]\n",
    "    steps = [MODEL_INFO.get(m, MODEL_INFO[\"llm\"])[\"step\"] for m in models]\n",
    "    colors = [STEP_COLORS[s] for s in steps]\n",
    "    ax.hlines(y, table.loc[models, \"ci_low\"], table.loc[models, \"ci_high\"], color=colors, lw=2.5)\n",
    "    ax.scatter(table.loc[models, \"macro-F1\"], y, color=colors, s=55, zorder=3, edgecolor=\"white\", linewidth=1.5)\n",
    "    for yi, m in zip(y, models):\n",
    "        ax.text(table.at[m, \"ci_high\"] + 0.01, yi, f\"{table.at[m, 'macro-F1']:.3f}\", va=\"center\", fontsize=9)\n",
    "    ax.set_yticks(y, [SHORT.get(m, \"LLM (zero-shot)\") for m in models])\n",
    "    ax.set_xlim(0.3, 1.0)\n",
    "    ax.set_xlabel(\"Macro-F1 (95% bootstrap CI)\")\n",
    "    ax.set_title(title)\n",
    "for step, color in STEP_COLORS.items():\n",
    "    axes[1].scatter([], [], color=color, label=step)\n",
    "axes[1].legend(loc=\"lower left\", title=\"project step\", fontsize=8, title_fontsize=9)\n",
    "fig.suptitle(\"The representation ladder: macro-F1 of every model\", y=1.02)\n",
    "fig.tight_layout()\n",
    "savefig(fig, \"crypt_ledger.png\")\n",
    "plt.show()"
