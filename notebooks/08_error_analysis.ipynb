   "source": [
    "keywords_train = np.array(lexicon.keywords(X_train), dtype=object)\n",
    "labels_train = train[\"label_name\"].to_numpy(dtype=object)\n",
    "context_rows = []\n",
    "for word in split_table.index:\n",
    "    pair = [split_table.at[word, \"majority\"], split_table.at[word, \"second\"]]\n",
    "    mask = (keywords_train == word) & np.isin(labels_train, pair)\n",
    "    texts = [\" \".join(t for t in text.split() if t != word) for text in np.asarray(X_train, dtype=object)[mask]]\n",
    "    y_word = labels_train[mask]\n",
    "    if np.min(np.unique(y_word, return_counts=True)[1]) < 5:\n",
    "        continue  # too few texts of the minority label for 5-fold cross-validation\n",
    "    cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=SEED)\n",
    "    clf = make_pipeline(TfidfVectorizer(), LogisticRegression(C=1.0, max_iter=2000, tol=1e-6))\n",
    "    pred_word = cross_val_predict(clf, texts, y_word, cv=cv)\n",
    "    majority_share = pd.Series(y_word).value_counts(normalize=True).iloc[0]\n",
    "    context_rows.append({\"keyword\": word, \"labels\": \" / \".join(pair), \"texts\": int(mask.sum()),\n",
    "                         \"majority baseline\": majority_share, \"context classifier (5-fold CV)\": np.mean(pred_word == y_word)})\n",
    "context_signal = pd.DataFrame(context_rows).set_index(\"keyword\")\n",
    "pooled = np.average(context_signal.iloc[:, 2:4], axis=0, weights=context_signal[\"texts\"])\n",
    "context_signal.loc[\"all split keywords (weighted)\"] = [\"\", int(context_signal[\"texts\"].sum()), pooled[0], pooled[1]]\n",
    "context_signal.to_csv(METRICS_DIR / \"split_keyword_context_signal.csv\")\n",
    "display(context_signal.style.format({\"majority baseline\": \"{:.3f}\", \"context classifier (5-fold CV)\": \"{:.3f}\"}))"
   ]
  },
