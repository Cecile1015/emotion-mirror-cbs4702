   "source": [
    "examples = pd.read_csv(DATA_DIR / \"handcrafted\" / \"error_examples.csv\")\n",
    "bert_predictor = load_predictor(\"bert\")\n",
    "example_rows = []\n",
    "for _, ex in examples.iterrows():\n",
    "    i = int(ex[\"idx\"])\n",
    "    assert preds[\"bert\"][i] != y_test[i], f\"text {i} is not a BERT error\"\n",
    "    bert_label = ID2LABEL[preds[\"bert\"][i]]\n",
    "    drops = occlusion(bert_predictor.predict_proba, X_test[i], bert_label)\n",
    "    auto = coded[\"bert\"].loc[i]\n",
    "    example_rows.append({\n",
    "        \"idx\": i, \"text\": X_test[i], \"gold\": ID2LABEL[y_test[i]],\n",
    "        \"BERT\": f\"{bert_label} ({probas['bert'][i].max():.2f})\",\n",
    "        \"TF-IDF+LR\": ID2LABEL[preds[\"tfidf_lr\"][i]], \"BiLSTM\": ID2LABEL[preds[\"bilstm\"][i]],\n",
    "        \"BERT occlusion\": f\"{drops.index[0]} ({drops.iloc[0]:+.2f})\",\n",
    "        \"auto category\": f\"{auto['code']} {auto['category']}\",\n",
    "        \"level\": ex[\"level\"], \"phenomenon\": ex[\"phenomenon\"], \"explanation\": ex[\"explanation\"],\n",
    "    })\n",
    "example_table = pd.DataFrame(example_rows)\n",
    "example_table.to_csv(METRICS_DIR / \"error_examples_test.csv\", index=False)\n",
    "pd.set_option(\"display.max_colwidth\", None)\n",
    "display(example_table.drop(columns=\"explanation\").style.hide(axis=\"index\")\n",
    "        .set_properties(subset=[\"text\"], **{\"text-align\": \"left\", \"white-space\": \"normal\", \"min-width\": \"260px\"}))"
   ]
  },
