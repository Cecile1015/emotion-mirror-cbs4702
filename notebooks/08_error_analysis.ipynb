    "lexicon = KeywordLexicon().fit(X_train, train[\"label_name\"].tolist())\n",
    "kw_table = lexicon.table_\n",
    "kw_table.to_csv(METRICS_DIR / \"keyword_lexicon_train.csv\")\n",
    "\n",
    "lookup_rows = []\n",
    "for split_name, texts, y_split in [(\"validation\", X_val, y_val), (\"test\", X_test, y_test)]:\n",
    "    gold = np.array([ID2LABEL[y] for y in y_split], dtype=object)\n",
    "    guess = np.array(lexicon.predict(texts), dtype=object)\n",
    "    covered = np.array([g is not None for g in guess])\n",
    "    row = {\"split\": split_name, \"texts\": len(texts), \"keyword found\": covered.mean(),\n",
    "           \"look-up accuracy (texts with keyword)\": np.mean(guess[covered] == gold[covered])}\n",
    "    for m in [\"tfidf_lr\", \"bert\"]:\n",
    "        split_pred = preds[m] if split_name == \"test\" else pd.read_csv(PRED_DIR / f\"{m}__validation.csv\")[\"pred\"].to_numpy()\n",
    "        row[f\"{SHORT[m]} accuracy (same texts)\"] = np.mean(split_pred[covered] == y_split[covered])\n",
    "    lookup_rows.append(row)\n",
    "lookup = pd.DataFrame(lookup_rows).set_index(\"split\")\n",
    "print(f\"Keyword lexicon: {len(kw_table)} keywords \"\n",
    "      f\"({(kw_table.kind == 'reliable').sum()} reliable, {(kw_table.kind == 'split').sum()} split, \"\n",
    "      f\"{(kw_table.kind == 'mixed').sum()} mixed)\")\n",
    "display(lookup.style.format(\"{:.3f}\", subset=lookup.columns[1:]).format(\"{:,}\", subset=[\"texts\"]))"
   ]
