   "source": [
    "comparisons = [(LADDER[i], LADDER[i + 1], \"test\") for i in range(len(LADDER) - 1)]\n",
    "comparisons += [(\"tfidf_lr\", \"bert\", \"test\"), (\"bert\", \"llm\", TEST_SUB)]\n",
    "questions = {\n",
    "    (\"bow_nb\", \"bow_lr\"): \"generative -> discriminative classifier (same counts)\",\n",
    "    (\"bow_lr\", \"tfidf_lr\"): \"raw counts -> TF-IDF weights\",\n",
    "    (\"tfidf_lr\", \"improved_lr\"): \"+ sublinear tf and class weights\",\n",
    "    (\"improved_lr\", \"glove_lr\"): \"sparse word identities -> averaged static vectors\",\n",
    "    (\"glove_lr\", \"bilstm\"): \"+ word order (recurrent encoder), fine-tuned vectors\",\n",
    "    (\"bilstm\", \"bert\"): \"+ contextual self-attention, pre-trained encoder\",\n",
    "    (\"tfidf_lr\", \"bert\"): \"baseline -> best model (overall gain)\",\n",
    "    (\"bert\", \"llm\"): \"fine-tuned encoder -> prompted decoder-only LLM\",\n",
    "}\n",
    "sig_rows = []\n",
    "for a, b, split in comparisons:\n",
    "    if split == \"test\":\n",
    "        yt, pa, pb = y_test, preds[a], preds[b]\n",
    "    else:\n",
    "        yt, pa, pb = y_sub, sub_preds[a], sub_preds[b]\n",
    "    mc = mcnemar_test(yt, pa, pb)\n",
    "    bs = paired_bootstrap(yt, pa, pb, n_boot=N_BOOT, seed=SEED)\n",
    "    sig_rows.append({\"comparison (A → B)\": f\"{SHORT[a]} → {SHORT[b]}\", \"question\": questions[(a, b)],\n",
    "                     \"texts\": len(yt), \"b (only A correct)\": mc[\"b\"], \"c (only B correct)\": mc[\"c\"],\n",
    "                     \"McNemar p\": mc[\"p_value\"], \"Δ macro-F1 (B − A)\": bs[\"delta\"],\n",
    "                     \"95% CI of Δ\": fmt_ci(bs[\"ci_low\"], bs[\"ci_high\"]), \"a\": a, \"b_id\": b})\n",
    "significance = pd.DataFrame(sig_rows)\n",
    "significance[\"Holm p\"] = holm(significance[\"McNemar p\"])\n",
    "significance[\"significant (Holm, 0.05)\"] = np.where(significance[\"Holm p\"] < 0.05, \"yes\", \"no\")\n",
    "significance.drop(columns=[\"a\", \"b_id\"]).to_csv(METRICS_DIR / \"significance_ladder_test.csv\", index=False)\n",
    "display(significance.drop(columns=[\"a\", \"b_id\"]).style.format(\n",
    "    {\"McNemar p\": \"{:.2g}\", \"Holm p\": \"{:.2g}\", \"Δ macro-F1 (B − A)\": \"{:+.3f}\"}).hide(axis=\"index\"))"
   ]
