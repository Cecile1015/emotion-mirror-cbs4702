   "source": [
    "lr_pipeline = joblib.load(CLASSICAL_DIR / \"tfidf_lr.joblib\")\n",
    "bert_only = np.where(~lr_ok & bert_ok)[0]\n",
    "lr_only = np.where(lr_ok & ~bert_ok)[0]\n",
    "\n",
    "\n",
    "def word_role(word, text):\n",
    "    # Role of a word in a text: its emotion keyword, another emotion word of the lexicon, or a non-emotion word.\n",
    "    keyword = feel_complement(text) if feel_complement(text) in kw_table.index else lexicon.keyword(text)\n",
    "    if word.split(\"@\")[0] == keyword:\n",
    "        return \"the keyword\"\n",
    "    return \"another lexicon keyword\" if word.split(\"@\")[0] in kw_table.index else \"a word outside the lexicon\"\n",
    "\n",
    "\n",
    "driver_rows = []\n",
    "for i in bert_only:\n",
    "    lr_label, gold = ID2LABEL[preds[\"tfidf_lr\"][i]], ID2LABEL[y_test[i]]\n",
    "    contrib = lr_contributions(lr_pipeline, X_test[i], lr_label, gold)\n",
    "    drops = occlusion(bert_predictor.predict_proba, X_test[i], gold)\n",
    "    driver_rows.append({\"idx\": i, \"gold\": gold, \"TF-IDF+LR\": lr_label,\n",
    "                        \"LR top word\": contrib.index[0], \"LR top word is\": word_role(contrib.index[0], X_test[i]),\n",
    "                        \"BERT top word\": drops.index[0], \"BERT top word is\": word_role(drops.index[0], X_test[i])})\n",
    "drivers = pd.DataFrame(driver_rows)\n",
    "roles = [\"the keyword\", \"another lexicon keyword\", \"a word outside the lexicon\"]\n",
    "role_table = pd.DataFrame({\n",
    "    \"TF-IDF+LR: word pushing most towards its wrong label\": drivers[\"LR top word is\"].value_counts(normalize=True),\n",
    "    \"BERT: word whose deletion lowers P(gold) most\": drivers[\"BERT top word is\"].value_counts(normalize=True),\n",
    "}).reindex(roles).fillna(0)\n",
    "print(f\"Texts that only BERT classifies correctly: {len(drivers)}\")\n",
    "display(role_table.style.format(\"{:.1%}\"))\n",
    "print(\"Most frequent words that pull TF-IDF + LR away from the gold label (not the keyword):\")\n",
    "display(drivers[drivers[\"LR top word is\"] != \"the keyword\"].groupby(\"LR top word\")\n",
    "        .agg(texts=(\"idx\", \"size\"), towards=(\"TF-IDF+LR\", lambda s: \", \".join(sorted(set(s)))))\n",
    "        .sort_values(\"texts\", ascending=False).head(12).T)"
   ]
  },
