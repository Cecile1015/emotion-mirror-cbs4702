    "coded = {}\n",
    "for m in LADDER:\n",
    "    frame = pred_frames[m]\n",
    "    coded[m] = frame[~frame[\"correct\"]].join(code_errors(frame[~frame[\"correct\"]], lexicon))\n",
    "codes_test = pd.concat([c.assign(model=m) for m, c in coded.items()])\n",
    "codes_test[[\"model\", \"idx\", \"text\", \"true_label\", \"pred_label\", \"code\", \"category\", \"level\", \"keyword\",\n",
    "            \"split_word\", \"scope_marker\", \"cue_classes\"]].to_csv(METRICS_DIR / \"error_codes_test.csv\", index=False)\n",
    "\n",
    "counts = pd.DataFrame({SHORT[m]: coded[m][\"code\"].value_counts() for m in LADDER}).T.reindex(\n",
    "    columns=ERROR_CATEGORIES.index).fillna(0).astype(int)\n",
    "counts[\"total errors\"] = counts.sum(axis=1)\n",
    "display(counts)\n",
