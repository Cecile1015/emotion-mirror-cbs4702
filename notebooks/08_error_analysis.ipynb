    "### 6.1 Predictions of every model\n",
    "\n",
    "All seven trained models are loaded through `src/predictors.py` and return their raw softmax probabilities. The LLM (few-shot prompt of Step 6) classifies the 60 sentences through the DeepSeek API; its answers are cached in `results/llm/cache/`, so the notebook re-runs without new requests. Its probabilities are degenerate at temperature 0 (Step 6), so the LLM takes part only in the label-based tests (MFT and INV)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "67812b92",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "application/vnd.jupyter.widget-view+json": {
       "model_id": "dc9b8d3eb46845848ea10f22e6fff7f8",
       "version_major": 2,
       "version_minor": 0
      },
      "text/plain": [
       "behavioural__fs_random_k3:   0%|          | 0/60 [00:00<?, ?it/s]"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "models tested: BoW+NB, BoW+LR, TF-IDF+LR, Improved LR, GloVe+LR, BiLSTM, BERT, LLM (few-shot)\n"
     ]
    }
   ],
   "source": [
    "texts_suite = suite[\"text\"].tolist()\n",
    "items, groups, skipped = [], [], {}\n",
    "for m in LADDER:\n",
    "    try:\n",
    "        predictor = bert_predictor if m == \"bert\" else load_predictor(m)\n",
    "    except FileNotFoundError as exc:\n",
    "        skipped[m] = str(exc)\n",
    "        continue\n",
    "    proba_suite = predictor.predict_proba(texts_suite)\n",
    "    scored = score_items(suite, proba_suite.argmax(axis=1), proba_suite, m)\n",
    "    items.append(scored)\n",
    "    groups.append(group_tests(scored))\n",
    "\n",
    "llm_prompt = load_prompt(LLM_DIR / \"prompt_llm.json\")\n",
    "client = DeepSeekClassifier()\n",
    "try:\n",
    "    llm_frame = client.run(llm_prompt, texts_suite, list(range(len(suite))), run_name=f\"behavioural__{llm_prompt.prompt_id}\")\n",
    "    scored = score_items(suite, llm_frame[\"pred\"].to_numpy(), None, \"llm\")\n",
    "    scored[\"llm_status\"] = llm_frame[\"status\"].to_numpy()\n",
    "    items.append(scored)\n",
    "    groups.append(group_tests(scored))\n",
    "except RuntimeError as exc:  # no API key and no cached answers\n",
    "    skipped[\"llm\"] = str(exc)\n",
    "\n",
    "items = pd.concat(items, ignore_index=True)\n",
    "groups = pd.concat(groups, ignore_index=True)\n",
    "models_run = [m for m in LADDER + [\"llm\"] if m in set(items[\"model\"])]\n",
    "items.to_csv(METRICS_DIR / \"behavioural_predictions.csv\", index=False)\n",
    "groups.to_csv(METRICS_DIR / \"behavioural_group_tests.csv\", index=False)\n",
    "print(\"models tested: \" + \", \".join(SHORT[m] for m in models_run))\n",
    "for m, reason in skipped.items():\n",
    "    print(f\"skipped {SHORT[m]}: {reason}\")"
   ]
