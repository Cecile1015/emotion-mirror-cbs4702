    "split_word_test = [lexicon.split_word_in(t) for t in X_test]\n",
    "has_split = np.array([w is not None for w in split_word_test])\n",
    "train_labels_of = train.groupby(\"text\")[\"label\"].agg(lambda s: set(s)).to_dict()\n",
    "conflict = np.array([t in train_labels_of and y not in train_labels_of[t] for t, y in zip(X_test, y_test)])\n",
    "\n",
    "noise_rows = []\n",
    "for m in LADDER:\n",
    "    wrong = preds[m] != y_test\n",
    "    noise_rows.append({\n",
    "        \"model\": SHORT[m],\n",
    "        \"accuracy, split-keyword texts\": np.mean(~wrong[has_split]),\n",
    "        \"accuracy, other texts\": np.mean(~wrong[~has_split]),\n",
    "        \"macro-F1, other texts\": macro_f1(y_test[~has_split], preds[m][~has_split]),\n",
    "        \"errors\": int(wrong.sum()),\n",
    "        \"errors on split-keyword texts\": int((wrong & has_split).sum()),\n",
    "        \"share of errors\": (wrong & has_split).sum() / wrong.sum(),\n",
    "    })\n",
    "noise = pd.DataFrame(noise_rows).set_index(\"model\")\n",
    "noise.to_csv(METRICS_DIR / \"split_keyword_accuracy_test.csv\")\n",
    "print(f\"Test texts with a split keyword: {has_split.sum()} ({has_split.mean():.1%}); \"\n",
    "      f\"test texts that occur in training with a different label: {conflict.sum()}\")\n",
    "display(noise.style.format({c: \"{:.3f}\" for c in noise.columns if c not in (\"errors\", \"errors on split-keyword texts\")}))\n",
    "follows_train = np.mean([ID2LABEL[preds[\"bert\"][i]] in {ID2LABEL[l] for l in train_labels_of[X_test[i]]}\n",
    "                         for i in np.where(conflict)[0]])\n",
    "print(f\"For {follows_train:.0%} of the conflicting duplicates BERT predicts the label the text has in training.\")\n",
