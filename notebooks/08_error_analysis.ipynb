    "STEP_COLORS = {\"Step 2\": \"#9AA5B1\", \"Step 3\": \"#3B6BA5\", \"Step 4\": \"#E8A33D\", \"Step 5\": \"#C0392B\", \"Step 6\": \"#2A9D8F\"}\n",
    "\n",
    "\n",
    "def savefig(fig, name):\n",
    "    fig.savefig(FIG_DIR / name, bbox_inches=\"tight\")\n",
    "\n",
    "\n",
    "def macro_f1(y_true, y_pred):\n",
    "    # Primary metric: unweighted mean of the six per-class F1 scores.\n",
    "    return f1_score(y_true, y_pred, labels=LABEL_IDS, average=\"macro\", zero_division=0)\n",
    "\n",
    "\n",
    "def bootstrap_ci(y_true, y_pred, n_boot=1000, seed=SEED):\n",
    "    # Percentile 95% confidence interval of macro-F1 over resampled evaluation sets\n",
    "    # (same procedure and seed as in Steps 2-6, so the intervals reproduce the saved ones).\n",
    "    y_true, y_pred = np.asarray(y_true), np.asarray(y_pred)\n",
    "    rng = np.random.default_rng(seed)\n",
    "    n = len(y_true)\n",
    "    scores = [macro_f1(y_true[idx], y_pred[idx]) for idx in (rng.integers(0, n, n) for _ in range(n_boot))]\n",
    "    return np.percentile(scores, [2.5, 97.5])\n",
    "\n",
    "\n",
    "def holm(p_values):\n",
    "    # Holm step-down adjustment of a list of p-values (controls the family-wise error rate).\n",
    "    p = np.asarray(p_values, dtype=float)\n",
    "    order = np.argsort(p)\n",
    "    adjusted = np.empty_like(p)\n",
    "    running = 0.0\n",
    "    for rank, i in enumerate(order):\n",
    "        running = max(running, (len(p) - rank) * p[i])\n",
    "        adjusted[i] = min(1.0, running)\n",
    "    return adjusted\n",
    "\n",
    "\n",
    "def fmt_ci(low, high):\n",
    "    return f\"[{low:+.3f}, {high:+.3f}]\" if low < 0 or high < 0 else f\"[{low:.3f}, {high:.3f}]\""
   ]
