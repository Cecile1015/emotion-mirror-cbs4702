    "def pass_table(frame, key, value):\n",
    "    table = frame.pivot_table(index=key, columns=\"model\", values=value, aggfunc=\"mean\").reindex(columns=models_run)\n",
    "    sizes = frame[frame[\"model\"] == models_run[0]].groupby(key).size()\n",
    "    table.index = [f\"{k} (n={sizes[k]})\" for k in table.index]\n",
    "    return table\n",
    "\n",
    "\n",
    "mft = items.assign(row=lambda d: np.where(d[\"capability\"] == \"negation\", \"negation: \" + d[\"variant\"],\n",
    "                                          \"MFT \" + d[\"capability\"]))\n",
    "mft_table = pass_table(mft, \"row\", \"mft_pass\")\n",
    "order = [\"negation: affirmative\", \"negation: negated\", \"negation: negation, emotion kept\", \"MFT sarcasm\",\n",
    "         \"MFT intensity\", \"MFT mixed\"]\n",
    "mft_table = mft_table.loc[[next(r for r in mft_table.index if r.startswith(o + \" (\")) for o in order]]\n",
    "mft_table.index = [r.replace(\"negation: \", \"MFT negation – \") for r in mft_table.index]\n",
    "group_table = pass_table(groups.dropna(subset=[\"pass\"]).assign(**{\"pass\": lambda d: d[\"pass\"].astype(float)}),\n",
    "                         \"test\", \"pass\")\n",
    "group_order = [\"INV: same label across intensities\", \"DIR: intensifier does not lower P(emotion)\",\n",
    "               \"DIR: negation lowers P(affirmed emotion)\", \"both emotions in the top two\"]\n",
    "group_table = group_table.loc[[next(r for r in group_table.index if r.startswith(o + \" (\")) for o in group_order]]\n",
    "results_table = pd.concat([mft_table, group_table])\n",
    "results_table.columns = [SHORT[m] for m in results_table.columns]\n",
    "results_table.to_csv(METRICS_DIR / \"behavioural_summary.csv\")\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(11, 5.4))\n",
    "sns.heatmap(results_table, annot=True, fmt=\".2f\", cmap=\"Blues\", vmin=0, vmax=1, linewidths=2, linecolor=\"white\",\n",
    "            cbar_kws={\"label\": \"pass rate\"}, ax=ax)\n",
    "ax.axhline(len(mft_table), color=\"white\", lw=6)\n",
    "ax.set_title(\"Behavioural tests: pass rate per capability and model\")\n",
    "ax.set_xlabel(\"\")\n",
    "ax.set_ylabel(\"\")\n",
    "ax.tick_params(axis=\"x\", rotation=0)\n",
    "savefig(fig, \"crypt_behavioural_tests.png\")\n",
    "plt.show()\n",
    "\n",
    "overall = []\n",
    "for m in models_run:\n",
    "    passed = items.loc[items[\"model\"] == m, \"mft_pass\"]\n",
    "    low, high = wilson_interval(int(passed.sum()), len(passed))\n",
    "    no_mixed = items.loc[(items[\"model\"] == m) & (items[\"capability\"] != \"mixed\"), \"mft_pass\"]\n",
    "    overall.append({\"model\": SHORT[m], \"MFT passed\": f\"{int(passed.sum())} / {len(passed)}\",\n",
    "                    \"pass rate\": passed.mean(), \"95% Wilson CI\": f\"[{low:.2f}, {high:.2f}]\",\n",
    "                    \"pass rate without the mixed sentences\": no_mixed.mean()})\n",
    "display(pd.DataFrame(overall).set_index(\"model\").style.format({\"pass rate\": \"{:.3f}\",\n",
    "                                                                \"pass rate without the mixed sentences\": \"{:.3f}\"}))\n",
    "\n",
    "# Degree modifiers: mean probability of the expected emotion per intensity variant (models with probabilities).\n",
    "intensity = items[(items[\"capability\"] == \"intensity\") & items[\"p_sadness\"].notna()].copy()\n",
    "intensity[\"P(emotion)\"] = [row[f\"p_{row['expected']}\"] for _, row in intensity.iterrows()]\n",
    "display(intensity.pivot_table(index=\"model\", columns=\"variant\", values=\"P(emotion)\")\n",
    "        .reindex(index=[m for m in models_run if m != \"llm\"], columns=[\"downtoned\", \"plain\", \"intensified\"])\n",
    "        .rename(index=SHORT).style.format(\"{:.3f}\").set_caption(\"Mean P(expected emotion) in the six intensity groups\"))\n",
    "\n",
    "if \"llm\" in models_run:\n",
    "    llm_items = items[items[\"model\"] == \"llm\"]\n",
    "    rates = llm_items.groupby(\"capability\")[\"mft_pass\"].mean()\n",
    "    display(Markdown(\n",
    "        f\"**LLM (few-shot).** MFT pass rates: negation {rates['negation']:.2f}, sarcasm {rates['sarcasm']:.2f}, \"\n",
    "        f\"intensity {rates['intensity']:.2f}, mixed {rates['mixed']:.2f}; negated sentences \"\n",
    "        f\"{llm_items.loc[llm_items['variant'] == 'negated', 'mft_pass'].mean():.2f}; answer status: \"\n",
    "        + \", \".join(f\"{k} {v}\" for k, v in llm_items[\"llm_status\"].value_counts().items()) + \".\"))"
   ]
