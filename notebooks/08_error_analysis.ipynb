   "source": [
    "rows = []\n",
    "for rung, m in enumerate(LADDER, start=1):\n",
    "    rec, info = records[m], MODEL_INFO[m]\n",
    "    low, high = bootstrap_ci(y_test, preds[m])\n",
    "    rows.append({\n",
    "        \"rung\": rung, \"model id\": m, \"model\": info[\"name\"], \"step\": info[\"step\"], \"lecture\": info[\"lecture\"],\n",
    "        \"pre-trained\": info[\"pretrained\"], \"word order\": info[\"word_order\"], \"contextual\": info[\"contextual\"],\n",
    "        \"val macro-F1\": val_records[m][\"macro_f1\"], \"test accuracy\": rec[\"accuracy\"],\n",
    "        \"test macro-F1\": rec[\"macro_f1\"], \"95% CI\": f\"[{low:.3f}, {high:.3f}]\", \"ci_low\": low, \"ci_high\": high,\n",
    "        \"weighted-F1\": rec[\"weighted_f1\"],\n",
    "    })\n",
    "ledger = pd.DataFrame(rows).set_index(\"model id\")\n",
    "ledger[\"Δ macro-F1 vs previous rung\"] = ledger[\"test macro-F1\"].diff()\n",
    "ledger.to_csv(METRICS_DIR / \"final_ledger_test.csv\")\n",
    "\n",
    "best_val = ledger[\"val macro-F1\"].idxmax()\n",
    "print(f\"Best model by validation macro-F1 (the selection criterion): {DISPLAY[best_val]} \"\n",
    "      f\"({ledger.at[best_val, 'val macro-F1']:.4f})\")\n",
    "display(ledger.drop(columns=[\"ci_low\", \"ci_high\", \"lecture\"]).style\n",
    "        .format({\"val macro-F1\": \"{:.3f}\", \"test accuracy\": \"{:.3f}\", \"test macro-F1\": \"{:.3f}\",\n",
    "                 \"weighted-F1\": \"{:.3f}\", \"Δ macro-F1 vs previous rung\": \"{:+.3f}\"}, na_rep=\"—\")\n",
    "        .background_gradient(subset=[\"test macro-F1\"], cmap=\"Blues\", vmin=0.5, vmax=0.95))"
   ]
  },
